PORT=3000
DATABASE_URL=postgres://USUARIO:PASSWORD@HOST:5432/NOMBRE_BD
DB_SSL=false

# Credenciales del administrador. Son obligatorias: si falta alguna, el servidor
# no arranca. Los valores de ejemplo sirven para un proyecto academico; cambialos
# en cualquier despliegue real.
ADMIN_USER=ejemplo
ADMIN_PASSWORD=ejemplo999

# Clave con la que se firman los tokens. Genera una con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=cambia-esta-clave
