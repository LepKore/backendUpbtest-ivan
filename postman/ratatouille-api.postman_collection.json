		{
			"key": "baseUrl",
			"value": "http://localhost:3000",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "productoId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "pedidoId",
			"value": "1",
			"type": "string"
		}
	]
}